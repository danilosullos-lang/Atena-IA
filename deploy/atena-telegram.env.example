# Copie para /etc/atena/telegram.env e preencha os valores reais.
# Nunca faça commit do arquivo preenchido.
ATENA_TELEGRAM_BOT_TOKEN=
ATENA_TELEGRAM_CHAT_ID=
ATENA_LOCAL_MODEL=qwen2.5:3b-instruct
ATENA_OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
ATENA_MEMORY_DB=/home/ubuntu/Atena-IA/atena_evolution/memory.sqlite3
ATENA_TELEGRAM_SESSION_PATH=/home/ubuntu/Atena-IA/data/telegram_sessions.json
ATENA_TELEGRAM_VOICE_SETTINGS_PATH=/home/ubuntu/Atena-IA/data/telegram_voice_settings.json
ATENA_TASKER_DISPATCH_URL=
ATENA_TASKER_HMAC_SECRET=
ATENA_TASKER_DEVICE_ID=android-principal
# Vazio por padrão: capacidades com efeitos externos exigem autorização explícita.
ATENA_CAPABILITY_ALLOWLIST=
ATENA_PROVIDER_QUOTA_DB=/home/ubuntu/Atena-IA/atena_evolution/provider_quota.sqlite3
# Zero ou ausente = sem limite local para o campo; o provedor ainda aplica a própria quota.
ATENA_GEMINI_DAILY_REQUESTS=0
ATENA_GEMINI_DAILY_TOKENS=0
ATENA_GEMINI_DAILY_USD=0
ATENA_ANTHROPIC_DAILY_REQUESTS=0
ATENA_ANTHROPIC_DAILY_TOKENS=0
ATENA_ANTHROPIC_DAILY_USD=0
ATENA_OPENAI_DAILY_REQUESTS=0
ATENA_OPENAI_DAILY_TOKENS=0
ATENA_OPENAI_DAILY_USD=0
