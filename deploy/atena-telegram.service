[Unit]
Description=Atena IA Telegram Bot
Documentation=https://github.com/danilosullos-lang/Atena-IA
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Atena-IA
EnvironmentFile=/etc/atena/telegram.env
Environment=PYTHONPATH=/home/ubuntu/Atena-IA
Environment=ATENA_TELEGRAM_LOG_LEVEL=INFO
ExecStart=/usr/bin/python3 /home/ubuntu/Atena-IA/scripts/atena_telegram_chat.py --poll-timeout 25
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
